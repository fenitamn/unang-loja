# ============================================================
# UNANG LOJA — Environment Variables (Fase 2B)
# Salin file ini menjadi .env.local untuk dev lokal.
# Produksi: set variabel yang sama di Vercel → Settings → Environment Variables.
# ============================================================

# --- Supabase (disarankan untuk produksi) ---
# Dashboard Supabase → Project Settings → API
# Tanpa variabel ini, dev lokal memakai file .data/store.json (tidak untuk produksi).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Autentikasi & sesi ---
# WAJIB di produksi. String acak minimal 16 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Admin pertama dibuat otomatis saat login admin pertama (min. 8 karakter).
# Di dev lokal tanpa env ini, default admin@unangloja.id / admin12345 dipakai.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin UNANG LOJA

# Opsional: izinkan file store lokal di produksi (hanya untuk demo terbatas).
# Jangan dipakai untuk data nyata di Vercel.
# ALLOW_LOCAL_DB=1

# --- Nomor tujuan pembayaran (publik, tampil di langkah pembayaran) ---
# Isi dengan nomor rekening/e-wallet resmi. Jika kosong, pelanggan diarahkan
# menghubungi admin via WhatsApp (tidak ada nomor contoh yang bisa ditransfer).
NEXT_PUBLIC_BCA_ACCOUNT=
NEXT_PUBLIC_BSI_ACCOUNT=
NEXT_PUBLIC_GOPAY_ACCOUNT=
NEXT_PUBLIC_OVO_ACCOUNT=
NEXT_PUBLIC_DANA_ACCOUNT=

# --- Notifikasi WhatsApp admin via Fonnte (https://fonnte.com) ---
# FONTE_TOKEN = token device dari dashboard Fonnte (scan QR 1x)
# ADMIN_WA    = nomor WA admin, format 62xxx (contoh: 6281234567890)
FONTE_TOKEN=
ADMIN_WA=
